# ==========================================
# Lakshan Enterprises B2B Portal Environment
# ==========================================

# 1. App Configuration
# The base URL of the application (e.g., http://localhost:3000 or your Vercel URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. Supabase Configuration (Database & Auth)
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 3. Resend Configuration (Email Notifications)
# Optional: Omit these to skip email notifications
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_EMAIL=your-email@example.com

# 4. Twilio Configuration (WhatsApp Notifications)
# Optional: Omit these to skip WhatsApp notifications
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=+14155238886
ADMIN_WHATSAPP=+919876543210
